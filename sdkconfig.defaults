# Default configuration of the ESP32 modular digital clock.
# Every value can be overridden in the IDF GUI ("idf.py menuconfig").

CONFIG_IDF_TARGET="esp32"

# --- FreeRTOS ---------------------------------------------------------------
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_UNICORE=n

# --- Network / NTP ----------------------------------------------------------
# The SNTP client of lwIP is used with two servers (pool.ntp.org + fallback).
CONFIG_LWIP_SNTP_MAX_SERVERS=3
CONFIG_LWIP_SNTP_UPDATE_DELAY=3600

# --- Wi-Fi ------------------------------------------------------------------
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n

# --- Flash / partition table ------------------------------------------------
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP=y

# --- Build ------------------------------------------------------------------
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_WARN_WRITE_STRINGS=y
CONFIG_CXX_COMPILER_ENABLE_EXCEPTIONS=n
CONFIG_CXX_COMPILER_ENABLE_RTTI=n
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# --- Logging ----------------------------------------------------------------
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
