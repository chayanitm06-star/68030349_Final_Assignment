{
  "version": 1,
  "author": "ESP32 Modular Digital Clock - ESP-IDF v6 (dashboard pin map)",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-ds1307", "id": "rtc", "top": -170, "left": -220, "attrs": {} },
    { "type": "wokwi-ssd1306", "id": "oled", "top": -170, "left": 120, "attrs": { "i2cAddress": "0x3c" } },
    { "type": "wokwi-pushbutton", "id": "btn_mode", "top": 150, "left": -180, "attrs": { "color": "blue", "label": "MODE (GPIO12)" } },
    { "type": "wokwi-pushbutton", "id": "btn_inc", "top": 150, "left": -80, "attrs": { "color": "green", "label": "INC (GPIO13)" } },
    { "type": "wokwi-pushbutton", "id": "btn_set", "top": 150, "left": 20, "attrs": { "color": "yellow", "label": "SET (GPIO14)" } },
    { "type": "wokwi-pushbutton", "id": "btn_lap", "top": 150, "left": 120, "attrs": { "color": "purple", "label": "LAP (GPIO27)" } },
    { "type": "wokwi-buzzer", "id": "buzzer", "top": 60, "left": 260, "attrs": { "volume": "0.1" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:21", "rtc:SDA", "cyan", [ "v0" ] ],
    [ "esp:22", "rtc:SCL", "yellow", [ "v0" ] ],
    [ "esp:3V3", "rtc:VCC", "red", [ "v0" ] ],
    [ "esp:GND.1", "rtc:GND", "black", [ "v0" ] ],
    [ "esp:21", "oled:SDA", "cyan", [ "v0" ] ],
    [ "esp:22", "oled:SCL", "yellow", [ "v0" ] ],
    [ "esp:3V3", "oled:VCC", "red", [ "v0" ] ],
    [ "esp:GND.2", "oled:GND", "black", [ "v0" ] ],
    [ "esp:12", "btn_mode:1.1", "purple", [ "v0" ] ],
    [ "esp:GND.3", "btn_mode:1.2", "black", [ "v0" ] ],
    [ "esp:13", "btn_inc:1.1", "green", [ "v0" ] ],
    [ "esp:GND.3", "btn_inc:1.2", "black", [ "v0" ] ],
    [ "esp:14", "btn_set:1.1", "yellow", [ "v0" ] ],
    [ "esp:GND.3", "btn_set:1.2", "black", [ "v0" ] ],
    [ "esp:27", "btn_lap:1.1", "purple", [ "v0" ] ],
    [ "esp:GND.3", "btn_lap:1.2", "black", [ "v0" ] ],
    [ "esp:25", "buzzer:1", "orange", [ "v0" ] ],
    [ "esp:GND.4", "buzzer:2", "black", [ "v0" ] ]
  ]
}
