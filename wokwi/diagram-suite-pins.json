{
  "version": 1,
  "author": "ESP32 Modular Digital Clock - ESP-IDF v6 (suite pin map)",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-ds1307", "id": "rtc", "top": -120, "left": 280, "attrs": {} },
    { "type": "wokwi-ssd1306", "id": "oled", "top": 120, "left": 280, "attrs": { "i2cAddress": "0x3c" } },
    { "type": "wokwi-pushbutton", "id": "btn_mode", "top": 280, "left": -120, "attrs": { "color": "red", "label": "MODE (GPIO18)" } },
    { "type": "wokwi-pushbutton", "id": "btn_set", "top": 280, "left": -20, "attrs": { "color": "green", "label": "SET (GPIO19)" } },
    { "type": "wokwi-pushbutton", "id": "btn_alarm", "top": 280, "left": 80, "attrs": { "color": "yellow", "label": "ALARM (GPIO4)" } },
