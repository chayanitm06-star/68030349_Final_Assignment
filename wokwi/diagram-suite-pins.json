    [ "esp:22", "oled:SCL", "cyan", [ "v0" ] ],
    [ "esp:18", "btn_mode:1.1", "green", [ "v0" ] ],
    [ "esp:GND.3", "btn_mode:1.2", "black", [ "v0" ] ],
    [ "esp:19", "btn_set:1.1", "green", [ "v0" ] ],
    [ "esp:GND.3", "btn_set:1.2", "black", [ "v0" ] ],
    [ "esp:4", "btn_alarm:1.1", "green", [ "v0" ] ],
    [ "esp:GND.3", "btn_alarm:1.2", "black", [ "v0" ] ],
    [ "esp:5", "btn_lap:1.1", "green", [ "v0" ] ],
    [ "esp:GND.3", "btn_lap:1.2", "black", [ "v0" ] ],
