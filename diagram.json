{
  "version": 1,
  "author": "ESP32 Modular Digital Clock - ESP-IDF v6 (dashboard pin map)",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-ds1307", "id": "rtc", "top": -120, "left": 280, "attrs": {} },
    { "type": "board-ssd1306", "id": "oled", "top": 120, "left": 280, "attrs": { "i2cAddress": "0x3c" } },
    { "type": "wokwi-pushbutton", "id": "btn_mode", "top": 280, "left": -120, "attrs": { "color": "blue", "label": "MODE", "key": "m" } },
    { "type": "wokwi-pushbutton", "id": "btn_inc", "top": 280, "left": -20, "attrs": { "color": "green", "label": "INC", "key": "i" } },
    { "type": "wokwi-pushbutton", "id": "btn_set", "top": 280, "left": 80, "attrs": { "color": "yellow", "label": "SET", "key": "s" } },
    { "type": "wokwi-pushbutton", "id": "btn_lap", "top": 280, "left": 180, "attrs": { "color": "purple", "label": "LAP", "key": "l" } },
    { "type": "wokwi-buzzer", "id": "buzzer", "top": -120, "left": -80, "attrs": { "volume": "0.1" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "" ],
    [ "esp:RX", "$serialMonitor:TX", "" ],
    [ "esp:GND.1", "rtc:GND", "black" ],
    [ "esp:5V", "rtc:5V", "red" ],
    [ "esp:21", "rtc:SDA", "yellow" ],
    [ "esp:22", "rtc:SCL", "cyan" ],
    [ "esp:GND.2", "oled:GND", "black" ],
    [ "esp:3V3", "oled:VCC", "red" ],
    [ "esp:21", "oled:SDA", "yellow" ],
    [ "esp:22", "oled:SCL", "cyan" ],
    [ "esp:12", "btn_mode:1.l", "purple" ],
    [ "esp:GND.3", "btn_mode:2.l", "black" ],
    [ "esp:13", "btn_inc:1.l", "green" ],
    [ "esp:GND.3", "btn_inc:2.l", "black" ],
    [ "esp:14", "btn_set:1.l", "yellow" ],
    [ "esp:GND.3", "btn_set:2.l", "black" ],
    [ "esp:27", "btn_lap:1.l", "purple" ],
    [ "esp:GND.3", "btn_lap:2.l", "black" ],
    [ "esp:25", "buzzer:2", "orange" ],
    [ "esp:GND.1", "buzzer:1", "black" ]
  ]
}
